{
  "schemaVersion": 1,
  "description": "Pact desktop client packaging. The only supported package is the current future-client runtime.",
  "packageProfile": "future-client",
  "bundle": {
    "moduleResourceDirectory": "modules",
    "manifestPath": "portable-data/future-client/packaging-modules.json"
  },
  "modules": {
    "client-gui": {
      "label": "Flutter future desktop frontend",
      "category": "core",
      "enabled": true,
      "required": true,
      "platforms": [
        "macos",
        "linux",
        "windows"
      ],
      "packaging": "flutter-app"
    },
    "client-cli": {
      "label": "Rust future client CLI sidecar",
      "category": "core",
      "enabled": true,
      "required": true,
      "platforms": [
        "macos",
        "linux",
        "windows"
      ],
      "packaging": "sidecar-binary",
      "cargoBin": "pact-client"
    },
    "portable-data": {
      "label": "Future client local state, mobile relay, activity, snapshots, and target config cache",
      "category": "storage",
      "enabled": true,
      "required": true,
      "platforms": [
        "macos",
        "linux",
        "windows"
      ],
      "packaging": "portable-data",
      "portableDirectories": [
        "future-client",
        "future-client/settings",
        "future-client/targets",
        "future-client/pairings",
        "future-client/skills",
        "future-client/pins",
        "future-client/mobile-relay",
        "future-client/activity",
        "future-client/snapshots",
        "target-config-cache"
      ]
    },
    "target-adapters": {
      "label": "Target adapters for OpenClaw, Claude Code, Codex, Antigravity, OpenCode, Copilot, Kilo Code, Cursor, and Hermes Agent",
      "category": "agents",
      "enabled": true,
      "required": true,
      "platforms": [
        "macos",
        "linux",
        "windows"
      ],
      "packaging": "runtime-capability",
      "requires": [
        "client-cli",
        "portable-data"
      ],
      "targetAdapters": [
        "openclaw",
        "claude-code",
        "codex",
        "antigravity",
        "opencode",
        "copilot",
        "kilo-code",
        "cursor",
        "hermes"
      ]
    },
    "mcp-plugins": {
      "label": "Peer MCP plugin lifecycle",
      "category": "mcp-plugins",
      "enabled": true,
      "required": true,
      "platforms": [
        "macos",
        "linux",
        "windows"
      ],
      "packaging": "runtime-capability",
      "requires": [
        "target-adapters",
        "portable-data"
      ]
    },
    "skill-hub": {
      "label": "Passive Skill Hub boundary",
      "category": "skill-hub",
      "enabled": true,
      "required": true,
      "platforms": [
        "macos",
        "linux",
        "windows"
      ],
      "packaging": "runtime-capability",
      "requires": [
        "client-cli",
        "portable-data"
      ]
    },
    "model-forwarding": {
      "label": "Thin model forwarding profiles and command routing",
      "category": "model-forwarding",
      "enabled": true,
      "required": true,
      "platforms": [
        "macos",
        "linux",
        "windows"
      ],
      "packaging": "runtime-capability",
      "requires": [
        "client-cli",
        "portable-data"
      ]
    },
    "mobile-relay": {
      "label": "Mobile pairing and command relay control plane",
      "category": "mobile-relay",
      "enabled": true,
      "required": true,
      "platforms": [
        "macos",
        "linux",
        "windows"
      ],
      "packaging": "runtime-capability",
      "requires": [
        "portable-data",
        "target-adapters"
      ]
    },
    "activity-snapshots": {
      "label": "Activity log and independent snapshot store",
      "category": "activity",
      "enabled": true,
      "required": true,
      "platforms": [
        "macos",
        "linux",
        "windows"
      ],
      "packaging": "runtime-capability",
      "requires": [
        "portable-data"
      ]
    },
    "settings": {
      "label": "Future client settings store",
      "category": "settings",
      "enabled": true,
      "required": true,
      "platforms": [
        "macos",
        "linux",
        "windows"
      ],
      "packaging": "runtime-capability",
      "requires": [
        "portable-data"
      ]
    }
  },
  "deferredCapabilities": {
    "clientd": {
      "status": "todo",
      "reason": "The current client has no background daemon; GUI and pact-client use explicit local commands and portable state."
    },
    "upload-queue": {
      "status": "todo",
      "reason": "Large-file upload queue is not part of the current future-client package."
    },
    "mcp-local-bridge": {
      "status": "todo",
      "reason": "The current MCP connector talks to authenticated HTTP/HTTPS Pact endpoints; no local stdio bridge is shipped."
    },
    "client-connectors": {
      "status": "todo",
      "reason": "Local data connectors are deferred; connector governance remains server-side until a client runtime is implemented."
    },
    "knowledge-cache": {
      "status": "todo",
      "reason": "The client does not ship a local long-term knowledge cache in the current package."
    },
    "mail-import-runtime": {
      "status": "todo",
      "reason": "Mail import remains a server ingestion flow; no client-side connector runtime is packaged."
    }
  }
}
