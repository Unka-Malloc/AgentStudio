{
  "schemaVersion": 1,
  "description": "Pact desktop client packaging. The only supported package is the current future-client runtime.",
  "packageProfile": "future-client",
  "bundle": {
    "moduleResourceDirectory": "modules",
    "manifestPath": "portable-data/future-client/packaging-modules.json"
  },
  "modules": {
    "client-gui": {
      "label": "Flutter future desktop frontend",
      "category": "core",
      "enabled": true,
      "required": true,
      "platforms": [
        "macos",
        "linux",
        "windows"
      ],
      "packaging": "flutter-app"
    },
    "client-cli": {
      "label": "Rust future client CLI sidecar",
      "category": "core",
      "enabled": true,
      "required": true,
      "platforms": [
        "macos",
        "linux",
        "windows"
      ],
      "packaging": "sidecar-binary",
      "cargoBin": "pact-client"
    },
    "portable-data": {
      "label": "Future client local state, activity, snapshots, and target config cache",
      "category": "storage",
      "enabled": true,
      "required": true,
      "platforms": [
        "macos",
        "linux",
        "windows"
      ],
      "packaging": "portable-data",
      "portableDirectories": [
        "future-client",
        "future-client/settings",
        "future-client/targets",
        "future-client/pairings",
        "future-client/skills",
        "future-client/pins",
        "future-client/activity",
        "future-client/snapshots",
        "target-config-cache"
      ]
    },
    "target-adapters": {
      "label": "Target adapters for OpenClaw, Claude Code, Codex, Gemini CLI, Antigravity, OpenCode, Copilot, Kilo Code, Cursor, Hermes Agent, and Windsurf",
      "category": "agents",
      "enabled": true,
      "required": true,
      "platforms": [
        "macos",
        "linux",
        "windows"
      ],
      "packaging": "runtime-capability",
      "requires": [
        "client-cli",
        "portable-data"
      ],
      "targetAdapters": [
        "openclaw",
        "claude-code",
        "codex",
        "gemini-cli",
        "antigravity",
        "opencode",
        "copilot",
        "kilo-code",
        "cursor",
        "hermes",
        "windsurf"
      ]
    },
    "mcp-plugins": {
      "label": "Peer MCP plugin lifecycle",
      "category": "mcp-plugins",
      "enabled": true,
      "required": true,
      "platforms": [
        "macos",
        "linux",
        "windows"
      ],
      "packaging": "runtime-capability",
      "requires": [
        "target-adapters",
        "portable-data"
      ]
    },
    "skill-hub": {
      "label": "Passive Skill Hub boundary",
      "category": "skill-hub",
      "enabled": true,
      "required": true,
      "platforms": [
        "macos",
        "linux",
        "windows"
      ],
      "packaging": "runtime-capability",
      "requires": [
        "client-cli",
        "portable-data"
      ]
    },
    "model-forwarding": {
      "label": "Thin model forwarding profiles and command routing",
      "category": "model-forwarding",
      "enabled": true,
      "required": true,
      "platforms": [
        "macos",
        "linux",
        "windows"
      ],
      "packaging": "runtime-capability",
      "requires": [
        "client-cli",
        "portable-data"
      ]
    },
    "activity-snapshots": {
      "label": "Activity log and independent snapshot store",
      "category": "activity",
      "enabled": true,
      "required": true,
      "platforms": [
        "macos",
        "linux",
        "windows"
      ],
      "packaging": "runtime-capability",
      "requires": [
        "portable-data"
      ]
    },
    "settings": {
      "label": "Future client settings store",
      "category": "settings",
      "enabled": true,
      "required": true,
      "platforms": [
        "macos",
        "linux",
        "windows"
      ],
      "packaging": "runtime-capability",
      "requires": [
        "portable-data"
      ]
    }
  }
}
