{
  "schemaVersion": "v0.0.1:schema:definition-1",
  "kind": "pact.external-service.config",
  "serviceId": "rag-service",
  "serviceName": "external.knowledge.rag",
  "displayName": "RAG Service",
  "mode": "connected",
  "startupPolicy": "external-only",
  "description": "Generic external RAG service endpoint discovered by Pact through the external service registry.",
  "featureIds": [
    "external-service-compatibility",
    "knowledge-retrieval"
  ],
  "requiredOperations": [],
  "upstream": {
    "type": "http",
    "url": "http://127.0.0.1:8788",
    "transport": "http",
    "timeoutMs": 60000,
    "metadata": {
      "serviceKind": "rag",
      "protocol": "http-json"
    }
  },
  "healthCheck": {
    "type": "http",
    "url": "http://127.0.0.1:8788/health",
    "timeoutMs": 10000,
    "required": false
  },
  "docker": {
    "dockerfile": "external-services/rag-service/Dockerfile",
    "image": "pact-rag-service:local",
    "ports": [
      "8788:8788"
    ],
    "env": {
      "RAG_BACKEND_URL": ""
    }
  },
  "metadata": {
    "managedBy": "pact.external-service-registry",
    "scanMode": "external-service.config.json"
  }
}
