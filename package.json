{
  "name": "pactium",
  "version": "0.1.0",
  "description": "Pactium — a protocol-layer framework for Operation Ledger, Checkpoint Tree, and Merkle State.",
  "author": "Unka Y.Y.",
  "license": "GPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Unka-Malloc/Pactium.git"
  },
  "bugs": {
    "url": "https://github.com/Unka-Malloc/Pactium/issues"
  },
  "homepage": "https://github.com/Unka-Malloc/Pactium#readme",
  "type": "module",
  "main": "./src/index.js",
  "types": "./src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "import": "./src/index.js",
      "default": "./src/index.js"
    },
    "./kernel": {
      "types": "./src/index.d.ts",
      "import": "./src/kernel.js",
      "default": "./src/kernel.js"
    },
    "./ledger": {
      "types": "./src/index.d.ts",
      "import": "./src/ledger.js",
      "default": "./src/ledger.js"
    },
    "./checkpoint-tree": {
      "types": "./src/index.d.ts",
      "import": "./src/checkpoint-tree.js",
      "default": "./src/checkpoint-tree.js"
    },
    "./merkle-state": {
      "types": "./src/index.d.ts",
      "import": "./src/merkle-state.js",
      "default": "./src/merkle-state.js"
    },
    "./http": {
      "types": "./src/index.d.ts",
      "import": "./src/http.js",
      "default": "./src/http.js"
    }
  },
  "bin": {
    "pactium": "bin/pactium.mjs"
  },
  "files": [
    "src/",
    "bin/",
    "docs/",
    "examples/",
    "README.md",
    "README.zh-CN.md",
    "SECURITY.md",
    "LICENSE"
  ],
  "engines": {
    "node": "^22.0.0 || ^24.0.0"
  },
  "scripts": {
    "start": "pactium serve",
    "test": "node --test tests/pactium/*.test.mjs",
    "verify": "npm run verify:core && npm run verify:hygiene",
    "verify:core": "node --test tests/pactium/*.test.mjs",
    "verify:hygiene": "node scripts/verify-pactium-hygiene.mjs",
    "pack:dry-run": "npm pack --dry-run"
  },
  "dependencies": {
    "better-sqlite3": "^12.9.0"
  }
}
