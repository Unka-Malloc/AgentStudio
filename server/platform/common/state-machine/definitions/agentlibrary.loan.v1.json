{
  "machineId": "agentlibrary.loan.v1",
  "entityType": "knowledge_loan",
  "version": "1.0.0",
  "description": "Lifecycle of control and access bounds on checked-out knowledge loans.",
  "initialState": "loan_requested",
  "states": [
    { "id": "loan_requested", "label": "Loan Requested" },
    { "id": "loan_active", "label": "Loan Active" },
    { "id": "renewal_requested", "label": "Renewal Requested" },
    { "id": "renewed", "label": "Renewed" },
    { "id": "expired", "label": "Expired", "terminal": true },
    { "id": "revoked", "label": "Revoked", "terminal": true },
    { "id": "returned", "label": "Returned", "terminal": true }
  ],
  "events": [
    { "id": "loan.request", "label": "Request Loan", "riskLevel": "low" },
    { "id": "loan.activate", "label": "Activate Loan", "riskLevel": "low" },
    { "id": "loan.renew_request", "label": "Request Renewal", "riskLevel": "low" },
    { "id": "loan.renew", "label": "Approve Renewal", "riskLevel": "medium" },
    { "id": "loan.expire", "label": "Expire Loan", "riskLevel": "low" },
    { "id": "loan.revoke", "label": "Revoke Loan", "riskLevel": "high" },
    { "id": "loan.return", "label": "Return Loan", "riskLevel": "low" }
  ],
  "totalMatrix": [
    { "from": "loan_requested", "event": "loan.request", "result": "ignored_idempotent_event" },
    { "from": "loan_requested", "event": "loan.activate", "result": "legal_transition", "to": "loan_active" },
    { "from": "loan_requested", "event": "loan.renew_request", "result": "illegal_transition", "errorCode": "LOAN_NOT_ACTIVE" },
    { "from": "loan_requested", "event": "loan.renew", "result": "illegal_transition", "errorCode": "LOAN_NOT_ACTIVE" },
    { "from": "loan_requested", "event": "loan.expire", "result": "legal_transition", "to": "expired" },
    { "from": "loan_requested", "event": "loan.revoke", "result": "legal_transition", "to": "revoked", "guards": ["policyAllowed"] },
    { "from": "loan_requested", "event": "loan.return", "result": "illegal_transition", "errorCode": "LOAN_NOT_ACTIVE" },

    { "from": "loan_active", "event": "loan.request", "result": "illegal_transition", "errorCode": "LOAN_ALREADY_ACTIVE" },
    { "from": "loan_active", "event": "loan.activate", "result": "ignored_idempotent_event" },
    { "from": "loan_active", "event": "loan.renew_request", "result": "legal_transition", "to": "renewal_requested" },
    { "from": "loan_active", "event": "loan.renew", "result": "illegal_transition", "errorCode": "LOAN_RENEW_NOT_REQUESTED" },
    { "from": "loan_active", "event": "loan.expire", "result": "legal_transition", "to": "expired" },
    { "from": "loan_active", "event": "loan.revoke", "result": "legal_transition", "to": "revoked", "guards": ["policyAllowed"] },
    { "from": "loan_active", "event": "loan.return", "result": "legal_transition", "to": "returned" },

    { "from": "renewal_requested", "event": "loan.request", "result": "illegal_transition", "errorCode": "LOAN_ALREADY_ACTIVE" },
    { "from": "renewal_requested", "event": "loan.activate", "result": "illegal_transition", "errorCode": "LOAN_RENEWAL_PENDING" },
    { "from": "renewal_requested", "event": "loan.renew_request", "result": "ignored_idempotent_event" },
    { "from": "renewal_requested", "event": "loan.renew", "result": "legal_transition", "to": "renewed", "guards": ["policyAllowed"] },
    { "from": "renewal_requested", "event": "loan.expire", "result": "legal_transition", "to": "expired" },
    { "from": "renewal_requested", "event": "loan.revoke", "result": "legal_transition", "to": "revoked", "guards": ["policyAllowed"] },
    { "from": "renewal_requested", "event": "loan.return", "result": "legal_transition", "to": "returned" },

    { "from": "renewed", "event": "loan.request", "result": "illegal_transition", "errorCode": "LOAN_ALREADY_ACTIVE" },
    { "from": "renewed", "event": "loan.activate", "result": "legal_transition", "to": "loan_active" },
    { "from": "renewed", "event": "loan.renew_request", "result": "illegal_transition", "errorCode": "LOAN_ALREADY_RENEWED" },
    { "from": "renewed", "event": "loan.renew", "result": "ignored_idempotent_event" },
    { "from": "renewed", "event": "loan.expire", "result": "legal_transition", "to": "expired" },
    { "from": "renewed", "event": "loan.revoke", "result": "legal_transition", "to": "revoked", "guards": ["policyAllowed"] },
    { "from": "renewed", "event": "loan.return", "result": "legal_transition", "to": "returned" },

    { "from": "expired", "event": "loan.request", "result": "illegal_transition", "errorCode": "LOAN_ALREADY_EXPIRED" },
    { "from": "expired", "event": "loan.activate", "result": "illegal_transition", "errorCode": "LOAN_ALREADY_EXPIRED" },
    { "from": "expired", "event": "loan.renew_request", "result": "illegal_transition", "errorCode": "LOAN_ALREADY_EXPIRED" },
    { "from": "expired", "event": "loan.renew", "result": "illegal_transition", "errorCode": "LOAN_ALREADY_EXPIRED" },
    { "from": "expired", "event": "loan.expire", "result": "ignored_idempotent_event" },
    { "from": "expired", "event": "loan.revoke", "result": "illegal_transition", "errorCode": "LOAN_ALREADY_EXPIRED" },
    { "from": "expired", "event": "loan.return", "result": "illegal_transition", "errorCode": "LOAN_ALREADY_EXPIRED" },

    { "from": "revoked", "event": "loan.request", "result": "illegal_transition", "errorCode": "LOAN_ALREADY_REVOKED" },
    { "from": "revoked", "event": "loan.activate", "result": "illegal_transition", "errorCode": "LOAN_ALREADY_REVOKED" },
    { "from": "revoked", "event": "loan.renew_request", "result": "illegal_transition", "errorCode": "LOAN_ALREADY_REVOKED" },
    { "from": "revoked", "event": "loan.renew", "result": "illegal_transition", "errorCode": "LOAN_ALREADY_REVOKED" },
    { "from": "revoked", "event": "loan.expire", "result": "illegal_transition", "errorCode": "LOAN_ALREADY_REVOKED" },
    { "from": "revoked", "event": "loan.revoke", "result": "ignored_idempotent_event" },
    { "from": "revoked", "event": "loan.return", "result": "illegal_transition", "errorCode": "LOAN_ALREADY_REVOKED" },

    { "from": "returned", "event": "loan.request", "result": "illegal_transition", "errorCode": "LOAN_ALREADY_RETURNED" },
    { "from": "returned", "event": "loan.activate", "result": "illegal_transition", "errorCode": "LOAN_ALREADY_RETURNED" },
    { "from": "returned", "event": "loan.renew_request", "result": "illegal_transition", "errorCode": "LOAN_ALREADY_RETURNED" },
    { "from": "returned", "event": "loan.renew", "result": "illegal_transition", "errorCode": "LOAN_ALREADY_RETURNED" },
    { "from": "returned", "event": "loan.expire", "result": "illegal_transition", "errorCode": "LOAN_ALREADY_RETURNED" },
    { "from": "returned", "event": "loan.revoke", "result": "illegal_transition", "errorCode": "LOAN_ALREADY_RETURNED" },
    { "from": "returned", "event": "loan.return", "result": "ignored_idempotent_event" }
  ],
  "invariants": ["SM-GOV-001", "SM-GOV-003", "SM-GOV-006", "SM-GOV-010"],
  "proofObligations": [
    "PO-LOAN-001",
    "PO-LOAN-002",
    "PO-LOAN-003",
    "PO-LOAN-004",
    "PO-LOAN-005"
  ],
  "proofMappings": [
    {
      "obligationId": "PO-LOAN-001",
      "method": "unit_test_enforced",
      "params": { "description": "denied access must not generate loan_active" }
    },
    {
      "obligationId": "PO-LOAN-002",
      "method": "terminal_state_share_retain_blocked",
      "params": { "target": "revoked" }
    },
    {
      "obligationId": "PO-LOAN-003",
      "method": "terminal_state_egress_blocked",
      "params": { "target": "expired" }
    },
    {
      "obligationId": "PO-LOAN-004",
      "method": "schema_and_unit_test_association",
      "params": { "requiredFields": ["receiptId", "auditId"] }
    },
    {
      "obligationId": "PO-LOAN-005",
      "method": "guard_validation",
      "params": { "allowedModes": ["checkoutAllowed"] }
    }
  ]
}
