{
  "schemaVersion": "v0.0.1:schema:definition-1",
  "kind": "pact.composition.preset",
  "presetId": "knowledge-transformation-standalone",
  "displayName": "Pact Agent Library",
  "status": "active",
  "compositionClass": "deployment-dependency-package",
  "deploymentTarget": {
    "applicationId": "knowledge-transformation",
    "serviceName": "external.knowledge.transformation",
    "boundary": "standalone-external-application",
    "outputBundleId": "pact-knowledge-transformation-standalone",
    "outputRoot": "build/composition-packages/knowledge-transformation-standalone"
  },
  "intent": {
    "summary": "Package the raw-corpus to knowledge-distillation pipeline with AgentLibrary access into a dehydrated external application.",
    "pipeline": [
      "raw-corpus-construction",
      "knowledge-index-construction",
      "knowledge-distillation"
    ],
    "accessSurface": "agent-library",
    "dehydrationGoal": "standalone-service-with-platform-core"
  },
  "coreDependencyPackage": {
    "policy": "include-platform-core-required-by-standalone-service",
    "featureIds": [
      "core-platform",
      "security-permissions",
      "operation-dispatcher",
      "console-shell",
      "storage-core",
      "module-management-core",
      "data-structure-core",
      "devops-core",
      "work-queue-core"
    ],
    "preserveContracts": [
      "v0.0.1:risk-control:permissions-1",
      "v0.0.1:operation:operation-dispatcher-1",
      "v0.0.1:storage:core-1",
      "v0.0.1:tool:module-management-1",
      "v0.0.1:platform:devops-1"
    ],
    "reason": "The standalone application still needs authorization, audit, operation dispatch, storage, module lifecycle, health, uploads, raw objects, and receipts."
  },
  "applicationDependencyPackage": {
    "policy": "include-knowledge-transformation-runtime-and-required-knowledge-services",
    "featureIds": [
      "document-parser",
      "analysis-runtime",
      "knowledge-core",
      "external-knowledge-distillation",
      "agent-gateway"
    ],
    "moduleDescriptors": [
      "server/platform/specialized/knowledge/transformation/module.json",
      "server/platform/specialized/knowledge/preprocessing/file-processor/module.json",
      "server/platform/specialized/knowledge/storage/knowledge-core/module.json",
      "server/platform/specialized/knowledge/storage/knowledge-backend-port/module.json",
      "server/platform/specialized/knowledge/retrieval/embedding-runtime/module.json",
      "server/platform/specialized/knowledge/retrieval/vector-store/module.json"
    ],
    "serviceRoots": [
      "external-services/knowledge-distillation-service"
    ],
    "requiredProtocols": [
      "v0.0.1:knowledge:transformation-1",
      "v0.0.1:knowledge:core-1",
      "v0.0.1:knowledge:access-1",
      "v0.0.1:agent:library-1",
      "v0.0.1:external-service:knowledge-distillation-1"
    ]
  },
  "pipeline": {
    "orderedStages": [
      {
        "stageId": "raw-corpus-construction",
        "required": true,
        "provider": "KnowledgeTransformation",
        "operationIds": [
          "raw-corpus.format.convert"
        ],
        "inputKinds": [
          "rawAsset",
          "file",
          "sourceCode",
          "knowledge"
        ],
        "outputKinds": [
          "normalizedDocument",
          "rawCorpusExport"
        ]
      },
      {
        "stageId": "knowledge-index-construction",
        "required": true,
        "provider": "KnowledgeCore",
        "mount": "knowledgeBase",
        "protocol": "v0.0.1:knowledge:core-1",
        "operationIds": [
          "knowledge.search",
          "knowledge.evidence.get",
          "knowledge.asset",
          "knowledge.render_markdown"
        ],
        "outputKinds": [
          "canonicalEvidence",
          "knowledgeIndex",
          "evidencePack"
        ]
      },
      {
        "stageId": "knowledge-distillation",
        "required": true,
        "provider": "ExternalKnowledgeDistillationService",
        "protocol": "v0.0.1:external-service:knowledge-distillation-1",
        "serviceRoot": "external-services/knowledge-distillation-service",
        "operationPrefixes": [
          "external.knowledge.distillation."
        ],
        "outputKinds": [
          "portableMarkdown",
          "portableDocx",
          "agentMessageJson",
          "workspacePackageZip"
        ]
      }
    ]
  },
  "agentLibrary": {
    "required": true,
    "role": "right-side-access-surface",
    "contracts": [
      "v0.0.1:knowledge:access-1",
      "v0.0.1:agent:library-1"
    ],
    "policy": {
      "secretHandling": "secretRef-only",
      "receiptRequired": true,
      "loanRecordRequired": true,
      "deniedAuditRequired": true,
      "enforceBefore": [
        "search",
        "evidence-read",
        "context-bundle",
        "export",
        "distillation",
        "memory-write"
      ]
    }
  },
  "dehydration": {
    "profileId": "knowledge-transformation-standalone",
    "mode": "detach-application-from-full-platform",
    "preserveCapabilities": [
      "authorization",
      "operation-dispatch",
      "audit",
      "raw-object-storage",
      "upload-session",
      "checkpoint-receipt",
      "module-lifecycle",
      "runtime-health"
    ],
    "removeSurfaces": [
      "full-control-panel",
      "agent-workspace-ui",
      "codespace-ui",
      "tool-skill-admin-ui",
      "production-readiness-console",
      "sample-business-pack-console"
    ],
    "externalize": [
      {
        "capability": "knowledge-distillation",
        "serviceRoot": "external-services/knowledge-distillation-service",
        "contract": "v0.0.1:external-service:knowledge-distillation-1"
      }
    ]
  },
  "dynamicModuleMount": {
    "enabled": true,
    "hotReloadableMounts": [
      "documentParser",
      "ocr",
      "pdfProcessor",
      "knowledgeBase",
      "vectorStore",
      "graphStore"
    ],
    "hotSwitchPolicy": "provider-contract-compatible-only",
    "hotUnloadPolicy": "require-dependency-detach-and-health-gate"
  },
  "startupComposition": {
    "enabled": true,
    "bindProviders": [
      {
        "contract": "v0.0.1:knowledge:transformation-1",
        "provider": "KnowledgeTransformation"
      },
      {
        "contract": "v0.0.1:knowledge:core-1",
        "provider": "KnowledgeCore.knowledgeBase"
      },
      {
        "contract": "v0.0.1:knowledge:access-1",
        "provider": "AgentLibraryAccessPolicy"
      },
      {
        "contract": "v0.0.1:external-service:knowledge-distillation-1",
        "provider": "ExternalKnowledgeDistillationService"
      }
    ],
    "healthGates": [
      "security-permissions",
      "storage-core",
      "knowledgeBase",
      "agent-library-access",
      "external-knowledge-distillation"
    ],
    "fallbackPolicy": "fail-fast-for-required-pipeline-stage"
  },
  "verification": [
    "npm run server:verify:knowledge-transformation --silent",
    "npm run server:verify:agent-library-access --silent",
    "npm run server:verify:knowledge-distillation-standalone-service --silent",
    "npm run server:verify:protocol-operations --silent"
  ]
}
