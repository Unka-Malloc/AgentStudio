{
  "schemaVersion": "v0.0.1:schema:definition-1",
  "name": "GerritCodeReviewRoute",
  "version": "v0.0.1:platform:gerrit-code-review-route-1",
  "category": "external-service-compatibility",
  "compatibilityLayer": "external-service-compatibility",
  "compatibilityBoundary": "remote-service",
  "serviceKind": "code-review",
  "serviceProviders": [
    "gerrit"
  ],
  "description": "Built-in compatibility component for agent-facing Gerrit code review operations through Pact MCP and Tool Management.",
  "defaultLoaded": true,
  "protocol": "v0.0.1:platform:code-review-1",
  "adapterProtocol": "v0.0.1:strategy:gerrit-rest-git-review-push-1",
  "maintenanceRunbook": "skills/codespace/pact-gerrit-mcp-maintainer/SKILL.md",
  "maintenanceSkill": "skills/codespace/pact-gerrit-mcp-maintainer/SKILL.md",
  "components": {
    "gerritMcpRoute": {
      "path": "./index.mjs",
      "factory": "executeGerritCommonOperation",
      "exports": [
        "GERRIT_ACTIONS",
        "executeGerritCommonOperation",
        "uploadGerritGitChange"
      ],
      "operations": [
        "gerrit.read",
        "gerrit.write",
        "gerrit.maintain",
        "gerrit.git_upload"
      ],
      "tools": [
        "pact.gerrit.read",
        "pact.gerrit.write",
        "pact.gerrit.maintain",
        "pact.gerrit.gitUpload"
      ],
      "requiredScopes": [
        "repo:read",
        "repo:write",
        "repo:maintain"
      ],
      "maxRisk": "repair_write",
      "auditRequired": true
    }
  },
  "runtime": {
    "localTestServer": {
      "gerritVersion": "3.14.0",
      "httpUrl": "http://localhost:18080/",
      "sshUrl": "ssh://localhost:29418",
      "stateRoot": "ServerConfig.getDataDir()/runtime/runtime-dependencies/gerrit",
      "runner": "war-or-docker",
      "preferredRunner": "war",
      "jreRuntimeRoot": "server/platform/modules/knowledge/runtime/jre"
    }
  },
  "verification": [
    "npm run server:gerrit:smoke --silent",
    "npm run server:verify:gerrit-mcp --silent",
    "PACT_VERIFY_GERRIT_LIVE=1 npm run server:verify:gerrit-mcp --silent",
    "npm run server:verify:mcp-http --silent",
    "npm run server:verify:tool-management --silent"
  ]
}
