{
  "name": "CloudDrivePort",
  "version": "v0.0.1:agent:cloud-drive-port-1",
  "description": "Internal backing adapter for the upstream Cloud Drive service gateway; iCloud and OneDrive local directory projections plus Google Drive and Dropbox contract-mode adapters are exposed through external.cloudDrive.* operations.",
  "defaultLoaded": false,
  "protocol": "v0.0.1:storage:cloud-drive-port-1",
  "components": {
    "cloudDrivePort": {
      "path": "./index.mjs",
      "factory": "createCloudDrivePort",
      "packaging": "operator-configured",
      "readOnlyRuntime": false,
      "providers": [
        "icloud",
        "onedrive",
        "google-drive",
        "dropbox"
      ],
      "configFile": "agent-workspaces/cloud-drive-connections.json"
    }
  },
  "operations": [
    "external.cloudDrive.connect",
    "external.cloudDrive.status",
    "external.cloudDrive.item.list",
    "external.cloudDrive.file.download",
    "external.cloudDrive.file.upload",
    "external.cloudDrive.sync.plan",
    "external.cloudDrive.sync.apply",
    "external.cloudDrive.permission.list"
  ],
  "verification": {
    "targeted": "npm run server:verify:v001-cloud-drive-e2e --silent",
    "contractMode": true
  }
}
